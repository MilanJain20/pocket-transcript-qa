# Pocket Transcript QA runs offline by default. No key is required.
POCKET_QA_PROVIDER=offline

# Optional live Pocket Public API client. Leave unset to use the mock client.
# POCKET_API_KEY=
# POCKET_API_BASE_URL=https://public.heypocketai.com/api/v1

# HMAC secret for inbound webhooks. The local server refuses unsigned
# deliveries unless POCKET_QA_ALLOW_UNSIGNED_WEBHOOKS=1.
# POCKET_WEBHOOK_SECRET=

# Optional LLM providers. Unused by the benchmark and the default CLI path.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
